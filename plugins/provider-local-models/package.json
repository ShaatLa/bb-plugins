{
  "name": "bb-plugin-local-models",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Local models",
